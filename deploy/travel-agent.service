[Unit]
Description=Travel Planning Agent (FastAPI)
Documentation=https://github.com/zn-cu/TravelAgent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=travel
Group=travel
WorkingDirectory=/opt/travel-agent

Environment=PYTHONUNBUFFERED=1
Environment=PYTHONUTF8=1

# ⚠️ 绝对不要加 --workers：HITL 的中断状态（checkpointer）存在进程内存里，
#    多进程会导致「中断在 A 进程、恢复请求打到 B 进程」，报"没有待确认的动作"。
#
# 监听 0.0.0.0:8080：没有反代，直接对公网提供访问。
# 鉴权由应用自带的 Basic Auth 负责（.env 里的 ACCESS_USER / ACCESS_PASSWORD）。
# 8080 是挑的"不容易和现有项目撞车"的端口，改之前先 ss -lntp | grep <端口> 确认空闲。
ExecStart=/opt/travel-agent/.venv/bin/python -m travel_agent.server --host 0.0.0.0 --port 8080

Restart=always
RestartSec=3

# 4G 机器给个上限，防止 PDF 渲染抖动把内存吃光（超了会被 OOM 杀掉然后自动重启）
MemoryMax=2G

NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
