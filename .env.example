# 复制本文件为 .env 后填入真实值；.env 已在 .gitignore 里，不会进版本库。

# 模型（DeepSeek）。也可以换成任何 langchain 支持的 provider:model
DEEPSEEK_API_KEY=sk-your-key-here
TRAVEL_MODEL=deepseek:deepseek-chat

# 高德地图 key：https://console.amap.com/dev/key 申请
AMAP_MAPS_API_KEY=your-amap-key-here

# 可调参数
BUDGET_LIMIT=5000            # 预算红线（元），超过会触发 HITL 第二道闸口
RAIL_MIN_INTERVAL=3.0        # 两次 12306 查询的最小间隔（秒）
RAIL_MAX_CALLS=20            # 单会话最多查 12306 几次

# 会话存储（可选）。不填就用内存，重启后会话丢失。
# 想持久化：docker run -d -p 6379:6379 redis:7 && pip install "redis>=5"
# REDIS_URL=redis://127.0.0.1:6379/0
# 有密码：REDIS_URL=redis://:你的密码@127.0.0.1:6379/0

# PDF 引擎（可选）：auto | weasyprint | xhtml2pdf | word
# auto 会按 weasyprint → xhtml2pdf → word 的顺序挑第一个装了的
PDF_ENGINE=auto
